# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries key NAMES and no values. Without this
# exception `.env*` above would swallow it and nobody would know which keys to
# set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# chrome-launcher (Lighthouse) temp profiles.
# Under WSL, LOCALAPPDATA holds a Windows path, so chrome-launcher creates a
# literal "C:\Users\...\lighthouse.12345678" directory in the working
# directory. Never ours to commit.
/C:*
