# Copy to .env.local and fill in. .env.local is git-ignored — never commit real
# keys. Vercel needs these same three set as project environment variables.

# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where audit requests are delivered. The owner's monitored inbox.
AUDIT_TO_EMAIL=

# The From: address. Must be on a domain verified in Resend, or sends fail.
# Not the same as AUDIT_TO_EMAIL — this one is a sender identity.
AUDIT_FROM_EMAIL=

# AI receptionist (RECEPTIONIST_SPEC.md). 1 = /api/voice/* answer; anything
# else, preview deploys included, is 404.
RECEPTIONIST_ENABLED=
# Retell API key: verifies the X-Retell-Signature on both webhooks.
RETELL_API_KEY=
# Cal.com username and the 15-minute intro event type's slug. Public booking
# needs no key; CAL_API_KEY is optional.
CAL_USERNAME=
CAL_EVENT_SLUG=
CAL_API_KEY=
# The Twilio account and number the summary text is sent from.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Gavin's mobile (+1 and ten digits): gets one text per call.
RECEPTIONIST_NOTIFY_TO=
# Optional. Default America/New_York.
BOOKING_TIMEZONE=
# Optional link template for the text, with {call_id}.
RECEPTIONIST_CALL_LINK=
# 1 = log the summary text instead of sending it (first live test calls).
RECEPTIONIST_DRY_RUN=
