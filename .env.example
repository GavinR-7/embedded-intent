# Copy to .env.local and fill in. .env.local is git-ignored — never commit real
# keys. Vercel needs these same three set as project environment variables.

# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where audit requests are delivered. The owner's monitored inbox.
AUDIT_TO_EMAIL=

# The From: address. Must be on a domain verified in Resend, or sends fail.
# Not the same as AUDIT_TO_EMAIL — this one is a sender identity.
AUDIT_FROM_EMAIL=

# Missed-call text-back (lib/textback). JSON array of clients, one per Twilio
# number: name, twilioNumber, ownerPhone, accountSid, authToken, optional
# template and helpContact. Contains auth tokens, so it is an env var only.
TEXTBACK_CLIENTS=
# Public origin Twilio is configured to call (e.g. https://embeddedintent.com).
# Optional; falls back to the forwarded host headers.
TEXTBACK_PUBLIC_ORIGIN=
